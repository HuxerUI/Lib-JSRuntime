{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@huxerui/tsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@huxerui/tsx": ["../../types/index.d.ts"],
      "@huxerui/tsx/jsx-runtime": ["../../types/jsx-runtime.d.ts"]
    }
  },
  "include": ["src/App.tsx"]
}
